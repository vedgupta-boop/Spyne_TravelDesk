# --- Google OAuth (sign-in, domain-locked) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_DOMAIN=spyne.ai

# --- Session cookie (HMAC) ---
SESSION_SECRET=

# --- Google Sheets storage (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEET_ID=

# --- Receipt uploads (Google Drive, shared drive folder) ---
GDRIVE_FOLDER_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=Spyne ReimburseDesk <onboarding@resend.dev>

# --- Approver routing overrides (optional; defaults in lib/config.js) ---
CEO_EMAIL=sanjay@spyne.ai
CEO_NAME=Sanjay Varnwal
FINANCE_SPOC=finance@spyne.ai
FINANCE_EMAILS=finance@spyne.ai
# Total-claim INR above which CEO approval is added after Finance.
CEO_THRESHOLD_INR=50000
# App FX rate to normalise USD claims for the threshold check (not an accounting rate).
FX_USD_INR=92

# --- App base URL (optional; auto-detected from request host otherwise) ---
APP_BASE_URL=

# --- Cron (reminders) ---
CRON_SECRET=
