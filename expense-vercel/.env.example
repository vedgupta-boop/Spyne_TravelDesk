# ---- Google Sheets (service account) ----
# Create a service account in Google Cloud, enable the Google Sheets API,
# download its JSON key, and share your spreadsheet (Editor) with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=svc-expense@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON. Keep the literal \n sequences (do not real-newline them).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# The spreadsheet ID from its URL: docs.google.com/spreadsheets/d/<THIS>/edit
# Use a DIFFERENT sheet from the Travel app.
SHEET_ID=

# Optional: Google Drive folder (shared Editor with the service account) for quotation/invoice uploads.
GDRIVE_FOLDER_ID=

# ---- Resend (email) ----
# Create an API key at resend.com and verify your sending domain.
RESEND_API_KEY=
# Must be an address on a Resend-verified domain (e.g. expenses@spyne.ai).
FROM_EMAIL=Spyne ExpenseDesk <expenses@spyne.ai>

# ---- Approval routing (optional overrides; defaults live in lib/config.js) ----
CEO_EMAIL=sanjay@spyne.ai
CEO_NAME=Sanjay Varnwal
FINANCE_SPOC=finance@spyne.ai
# Threshold (per-transaction, INR) above which Sanjay (CEO) must approve before Finance.
CEO_THRESHOLD_INR=50000
# FX rate used ONLY to normalise USD amounts for the threshold check.
FX_USD_INR=92

# ---- App ----
# Set to your deployed URL so approval email links are absolute.
# If unset, the API derives it from the incoming request host (works on Vercel).
APP_BASE_URL=

# ---- Auth: Google sign-in (domain-locked) ----
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud → Credentials.
# Authorized redirect URI: https://<your-app>/api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# A long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Only accounts on this Google Workspace domain may sign in.
ALLOWED_DOMAIN=spyne.ai
# Comma-separated emails granted the Finance view (everyone else = requester / HOD / CEO by email).
FINANCE_EMAILS=finance@spyne.ai,finance.head@spyne.ai

# ---- Cron (24h reminders) ----
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=
